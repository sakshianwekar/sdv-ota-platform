# Build artifacts
**/build/
*.o
*.obj
*.out
*.exe
migrate

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Signing private key (public key is tracked)
Tools/keys/ota_signing_key.pem

# Generated OTA packages and tooling output
packages/
Tools/output/

# Virtual ECU runtime (regenerated by init/demo scripts)
Virtual_ECU/*/runtime/*
!Virtual_ECU/*/runtime/.gitkeep
Virtual_ECU/*/logs/*
!Virtual_ECU/*/logs/.gitkeep
Virtual_ECU/*/flash/slotA/*
!Virtual_ECU/*/flash/slotA/.gitkeep
Virtual_ECU/*/flash/slotB/*
!Virtual_ECU/*/flash/slotB/.gitkeep
Virtual_ECU/*/config/previous_version.txt
Virtual_ECU/*/config/pending_version.txt

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
